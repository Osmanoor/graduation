# Large data files — pulled from Drive on demand
data/raw/*.pkl
data/raw/*.txt
data/raw/large/
data/computed/*.pkl

# Notebook checkpoints
**/.ipynb_checkpoints/

# Python
__pycache__/
*.pyc

# Allow small files explicitly (override above patterns)
!data/raw/.gitkeep
!data/computed/.gitkeep
!output/pdf/.gitkeep
!output/png/.gitkeep
