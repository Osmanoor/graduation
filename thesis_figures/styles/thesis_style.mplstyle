# Thesis figure style — Dr. Tahani's guidelines
# 12pt body in thesis; figures embed at ~6in width, scale to roughly 10pt readable.
# No titles inside figures (LaTeX \caption handles it).
# Grayscale-safe palette for B&W printing.

font.family: serif
font.serif: Times New Roman, DejaVu Serif, serif
font.size: 10

axes.titlesize: 10
axes.labelsize: 10
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.axisbelow: True

grid.alpha: 0.3
grid.linestyle: --
grid.linewidth: 0.5

xtick.labelsize: 9
ytick.labelsize: 9
xtick.direction: out
ytick.direction: out

legend.fontsize: 9
legend.frameon: False
legend.borderaxespad: 0.5

figure.figsize: 6.0, 4.0
figure.dpi: 100

# 300 DPI for PNG; vector for PDF (set in savefig per call)
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.05

# Muted accent palette — examiner-friendly, prints reasonably in B&W.
# Order: highlight (teal, "ours/best"), comparison (purple), neutral (gray),
# then a tertiary (orange-brown for fusion), and grayscale fallbacks.
axes.prop_cycle: cycler(color=["1f6f8a", "6d4a8f", "5c5c5c", "a05a30", "8c8c8c", "b3b3b3"])

# Lines and bars
lines.linewidth: 1.5
lines.markersize: 5
patch.linewidth: 0.5
patch.edgecolor: black
