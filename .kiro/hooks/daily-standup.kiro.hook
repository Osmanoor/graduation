{
  "enabled": true,
  "name": "Daily Research Standup",
  "description": "Check tasks and plan the day",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Read TASKS.md and tell me: 1) Which tasks are marked 'In Progress'? 2) Which tasks can I start today based on dependencies? 3) Are there any blocked tasks? Do NOT invent task status - only report what's in the file."
  }
}