{
  "enabled": true,
  "name": "Summarize Paper",
  "description": "Add a paper to literature review",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "I want to add a paper to our literature review. I'll give you the paper details. Create a summary in papers/[YEAR]_[Title].md following the exact template in paper-analysis.md steering. After creating, tell me which tasks this paper might be relevant to (check TASKS.md context files). Only include information I provide - do NOT invent details."
  },
  "workspaceFolderName": "graduation",
  "shortName": "summarize-paper"
}