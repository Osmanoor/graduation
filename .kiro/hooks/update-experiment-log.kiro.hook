{
  "enabled": true,
  "name": "Update Experiment Log",
  "description": "Document a completed experiment by collecting test details, metric values, dataset info, and learnings, then creating a structured file in experiments/ following the experiment-documentation.md template",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "I completed an experiment and need to document it. Ask me: 1) Which task was this for? (e.g., Task 2.3) 2) What were the exact metric values? (Recall@10, NDCG@10, MRR) 3) What dataset subset did you use? 4) What did you learn? Then: A) Create experiment doc in experiments/exp_XXX.md following experiment-documentation.md template, B) Update the task's Outcomes section in TASKS.md, C) Tell me which other context files should be updated (e.g., RESEARCH_CONTEXT_KERNEL.md.md). Do NOT invent any metric values - only use what I provide."
  },
  "workspaceFolderName": "graduation",
  "shortName": "update-experiment-log"
}